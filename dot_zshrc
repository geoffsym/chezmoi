# ~/.zshrc: Sourced for interactive Zsh sessions only.

# --- Antidote Plugin Manager ---
zplugins_txt=${ZDOTDIR:-$HOME}/.zsh_plugins.txt
zplugins_zsh=${ZDOTDIR:-$HOME}/.zsh_plugins.zsh

if [[ -f ~/.local/share/antidote/antidote.zsh ]]; then
  if [[ ! -f $zplugins_zsh || $zplugins_txt -nt $zplugins_zsh ]]; then
    source ~/.local/share/antidote/antidote.zsh
    antidote bundle < $zplugins_txt > $zplugins_zsh
  fi
  source $zplugins_zsh
else
  echo "Notice: Antidote not found at ~/.local/share/antidote. Run 'chezmoi apply' to install."
fi

# --- Tab Completion ---
autoload -Uz compinit
compinit -d "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump"
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'  # Case-insensitive tab completion
zstyle ':completion:*' menu select

# --- Prompt (Pure) ---
autoload -U promptinit; promptinit
prompt pure

# --- History Configuration ---
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt EXTENDED_HISTORY      # Save timestamps and duration
setopt SHARE_HISTORY         # Share history between live sessions
setopt HIST_IGNORE_SPACE     # Leading space prevents saving command
setopt HIST_IGNORE_ALL_DUPS  # Drop older duplicate when a command is repeated
setopt HIST_SAVE_NO_DUPS     # Don't write duplicates to history file
setopt HIST_FIND_NO_DUPS     # Don't show duplicates when searching
setopt HIST_REDUCE_BLANKS    # Tidy superfluous whitespace
setopt HIST_VERIFY           # Show expanded history (e.g. !!) before running

# --- Keybindings ---
bindkey ' ' magic-space  # Expands !! automatically on space
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
[[ -n "$terminfo[kcuu1]" ]] && bindkey "$terminfo[kcuu1]" history-substring-search-up
[[ -n "$terminfo[kcud1]" ]] && bindkey "$terminfo[kcud1]" history-substring-search-down

# --- Aliases ---
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias wget='wget -c'

# Debian/Ubuntu package name mappings
if [[ -f /etc/debian_version ]]; then
  alias bat=batcat
  alias fd=fdfind
fi

# Directory listings with eza (conditional on NERD_FONT)
if [[ -n "$NERD_FONT" ]]; then
  alias ls='eza -al --color=always --group-directories-first --icons'
  alias la='eza -a --color=always --group-directories-first --icons'
  alias ll='eza -l --color=always --group-directories-first --icons'
  alias lt='eza -aT --color=always --group-directories-first --icons'
else
  alias ls='eza -al --color=always --group-directories-first'
  alias la='eza -a --color=always --group-directories-first'
  alias ll='eza -l --color=always --group-directories-first'
  alias lt='eza -aT --color=always --group-directories-first'
fi

# Run previous command with sudo or prefix command with sudo
function please() {
  if [[ $# -eq 0 ]]; then
    eval sudo $(fc -ln -1)
  else
    sudo "$@"
  fi
}
alias pls=please
alias plz=please

# --- Machine-Specific Local Overrides (Untracked) ---
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# --- Greeting ---
command -v fastfetch &>/dev/null && fastfetch
