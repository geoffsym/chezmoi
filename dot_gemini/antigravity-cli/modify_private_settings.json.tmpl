#!/bin/bash
set -euo pipefail

# Read current on-disk file from stdin (or empty JSON if file does not exist)
CURRENT=$(cat)
[ -z "$CURRENT" ] && CURRENT="{}"

# Render the managed partial JSON from .chezmoitemplates
MANAGED=$(cat << 'EOF'
{{ includeTemplate ".chezmoitemplates/antigravity/settings.json.tmpl" . }}
EOF
)

# Deep merge managed keys, union arrays preserving existing order, and recursively prune nulls
echo "$CURRENT" | jq --argjson managed "$MANAGED" '
  $ARGS.named.managed as $m |
  (
    (.permissions.allow // []) as $orig_allow |
    (.permissions.ask // []) as $orig_ask |
    (.permissions.deny // []) as $orig_deny |
    (.trustedWorkspaces // []) as $orig_ws |
    (. * $m) |
    .permissions.allow = ($orig_allow + (($m.permissions.allow // []) - $orig_allow)) |
    .permissions.ask = ($orig_ask + (($m.permissions.ask // []) - $orig_ask)) |
    .permissions.deny = ($orig_deny + (($m.permissions.deny // []) - $orig_deny)) |
    .trustedWorkspaces = ($orig_ws + (($m.trustedWorkspaces // []) - $orig_ws))
  )
  | walk(if type == "object" then with_entries(select(.value != null)) else . end)
'
