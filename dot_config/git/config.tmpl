[user]
{{- if .work }}
	email = gsymonds@paychex.com
{{- else }}
	email = geoff.sym93@gmail.com
{{- end }}
	name = Geoff Symonds
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
{{- if not .work }}
[credential "https://git.local.geoff.app"]
	helper = 
	useHttpPath = true
	helper = !GITEA_CLI_CONFIG_DIR={{ .chezmoi.homeDir }}/.config/gitea-cli /usr/bin/gt auth git-credential --host https://git.local.geoff.app
[safe]
	directory = /opt/*
{{- end }}
[init]
	defaultBranch = main
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[rebase]
	autosquash = true
	autostash = true
[push]
	default = current
	autoSetupRemote = true
[fetch]
	prune = true
[diff]
	algorithm = histogram
[pull]
	rebase = true
[merge]
	conflictstyle = zdiff3
