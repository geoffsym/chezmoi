{{- $is_omv := or (eq .chezmoi.hostname "nas") (stat "/etc/openmediavault") (and (stat "/etc/issue") (contains "openmediavault" (lower (include "/etc/issue")))) -}}
{{- $is_rpi := or (hasPrefix "pi-" .chezmoi.hostname) (and (stat "/proc/device-tree/model") (contains "Raspberry Pi" (include "/proc/device-tree/model"))) -}}
{{- $is_steamdeck := or (eq .chezmoi.hostname "steamdeck") (and (hasKey .chezmoi "osRelease") (eq .chezmoi.osRelease.id "steamos")) -}}
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
{{- if $is_omv }}
  "logo": {
    "type": "file-raw",
    "source": "{{ .chezmoi.homeDir }}/.config/fastfetch/omv.ansi"
  },
  "display": {
    "color": {
      "keys": "38;5;74",
      "title": "38;5;74"
    }
  },
{{- else if $is_rpi }}
  "logo": {
    "source": "raspbian"
  },
{{- else if $is_steamdeck }}
  "logo": {
    "source": "SteamDeck"
  },
{{- end }}
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}
