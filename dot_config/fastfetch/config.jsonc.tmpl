{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
{{- if stat "/etc/openmediavault" }}
  "logo": {
    "type": "file-raw",
    "source": "{{ .chezmoi.homeDir }}/.config/fastfetch/omv.ansi"
  },
  "display": {
    "color": {
      "keys": "38;5;74",
      "title": "38;5;74"
    }
  },
{{- else if eq .chezmoi.hostname "steamdeck" }}
  "logo": {
    "source": "SteamDeckOled"
  },
{{- else if hasPrefix "pi-" .chezmoi.hostname }}
  "logo": {
    "source": "raspbian"
  },
{{- end }}
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
{{- if .desktop }}
    "display",
    "de",
{{- end }}
    "cpu",
    "gpu",
    "memory",
    {
      "type": "disk",
{{- if eq .chezmoi.hostname "steamdeck" }}
      "hideFolders": "/esp:/var:/efi:/boot*"
{{- else }}
      "folders": "/"
{{- end }}
    },
    "zpool",
    "loadavg",
    "battery",
    "localip",
    "break",
    "colors"
  ]
}
