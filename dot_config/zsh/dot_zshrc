# ~/.config/zsh/.zshrc: Sourced for interactive Zsh sessions only.

# --- Antidote Plugin Manager ---
zplugins_txt=${ZDOTDIR:-$HOME/.config/zsh}/.zsh_plugins.txt
zplugins_zsh=${ZDOTDIR:-$HOME/.config/zsh}/.zsh_plugins.zsh

antidote_path=""
if [[ -f /usr/share/zsh-antidote/antidote.zsh ]]; then
  antidote_path="/usr/share/zsh-antidote/antidote.zsh"
elif [[ -f /home/linuxbrew/.linuxbrew/opt/antidote/share/antidote/antidote.zsh ]]; then
  antidote_path="/home/linuxbrew/.linuxbrew/opt/antidote/share/antidote/antidote.zsh"
elif [[ -f "${XDG_DATA_HOME:-$HOME/.local/share}/antidote/antidote.zsh" ]]; then
  antidote_path="${XDG_DATA_HOME:-$HOME/.local/share}/antidote/antidote.zsh"
fi

if [[ -n "$antidote_path" ]]; then
  source "$antidote_path"
  if [[ ! -f $zplugins_zsh || $zplugins_txt -nt $zplugins_zsh ]]; then
    antidote bundle < $zplugins_txt > $zplugins_zsh
  fi
  source $zplugins_zsh
else
  echo "Notice: Antidote not found. Install via 'brew install antidote' or 'paru -S zsh-antidote'."
fi

# --- Tab Completion ---
autoload -Uz compinit
compinit -d "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump"
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'  # Case-insensitive tab completion
zstyle ':completion:*' menu select

# --- Prompt (Pure) ---
autoload -U promptinit; promptinit
prompt pure

# --- History Configuration ---
HISTFILE="${ZDOTDIR:-$HOME/.config/zsh}/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt EXTENDED_HISTORY      # Save timestamps and duration
setopt SHARE_HISTORY         # Share history between live sessions
setopt HIST_IGNORE_SPACE     # Leading space prevents saving command
setopt HIST_IGNORE_ALL_DUPS  # Drop older duplicate when a command is repeated
setopt HIST_SAVE_NO_DUPS     # Don't write duplicates to history file
setopt HIST_FIND_NO_DUPS     # Don't show duplicates when searching
setopt HIST_REDUCE_BLANKS    # Tidy superfluous whitespace
setopt HIST_VERIFY           # Show expanded history (e.g. !!) before running

# --- Keybindings ---
bindkey ' ' magic-space  # Expands !! automatically on space
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
[[ -n "$terminfo[kcuu1]" ]] && bindkey "$terminfo[kcuu1]" history-substring-search-up
[[ -n "$terminfo[kcud1]" ]] && bindkey "$terminfo[kcud1]" history-substring-search-down

# --- Modular Interactive Drop-ins ---
if [[ -d "${ZDOTDIR:-$HOME/.config/zsh}/zshrc.d" ]]; then
  for file in "${ZDOTDIR:-$HOME/.config/zsh}/zshrc.d"/*.zsh(N); do
    [[ -r "$file" ]] && source "$file"
  done
  unset file
fi

# --- Greeting ---
if command -v fastfetch &>/dev/null; then
  if (( COLUMNS >= 85 )); then
    fastfetch
  else
    fastfetch --logo-position top
  fi
fi
