{
  "$schema": "https://antigravity.google/schemas/v1/settings.json",
  "allowNonWorkspaceAccess": true,
  "colorScheme": "dark",
  "model": "Gemini 4 Hydrogen (High)",
  "queuedMessages": "send-immediately",
  "showFeedbackSurvey": false,
  "permissions": {
    "deny": [
      "read_file(.env)",
      "read_file(.env.local)",
      "read_file({{ .chezmoi.homeDir }}/.ssh)",
      "read_file({{ .chezmoi.homeDir }}/.gemini/config/mcp_config.json)",
      "read_file({{ .chezmoi.homeDir }}/.config/zsh/zshenv.d/mcp_secrets.zsh)"
    ],
    "ask": [
      "mcp(vikunja/do_action)",
      "mcp(vikunja/labels_delete)",
      "mcp(vikunja/projects_delete)",
      "mcp(vikunja/task_assignees_delete)",
      "mcp(vikunja/task_comments_delete)",
      "mcp(vikunja/tasks_delete)"
    ],
    "allow": [
      "read_file(*)",
      "read_url(github.com)",
      "read_url(githubusercontent.com)",
      "read_url(local.geoff.app)",
      "read_url(antigravity.google)",
      "mcp(lab-mcp/*)",
      "mcp(vikunja/*)",
      "command(ls)",
      "command(eza)",
      "command(tree)",
      "command(find)",
      "command(fd)",
      "command(cat)",
      "command(bat)",
      "command(head)",
      "command(tail)",
      "command(fastfetch)",
      "command(grep)",
      "command(rg)",
      "command(diff)",
      "command(strings)",
      "command(wc)",
      "command(stat)",
      "command(file)",
      "command(readlink)",
      "command(realpath)",
      "command(jq)",
      "command(sort)",
      "command(uniq)",
      "command(cut)",
      "command(tr)",
      "command(which)",
      "command(whereis)",
      "command(lsblk)",
      "command(df)",
      "command(du)",
      "command(findmnt)",
      "command(free)",
      "command(uptime)",
      "command(uname)",
      "command(lscpu)",
      "command(ps)",
      "command(pgrep)",
      "command(lsof)",
      "command(nvidia-smi)",
      "command(lspci)",
      "command(lsusb)",
      "command(journalctl)",
      "command(dmesg)",
      "command(systemctl status)",
      "command(systemctl cat)",
      "command(systemctl show)",
      "command(systemctl list-units)",
      "command(systemctl list-unit-files)",
      "command(systemctl list-timers)",
      "command(systemctl is-active)",
      "command(systemctl is-enabled)",
      "command(systemctl is-failed)",
      "command(systemctl --user status)",
      "command(systemctl --user cat)",
      "command(systemctl --user show)",
      "command(systemctl --user list-units)",
      "command(systemctl --user list-unit-files)",
      "command(systemctl --user list-timers)",
      "command(systemctl --user is-active)",
      "command(systemctl --user is-enabled)",
      "command(systemctl --user is-failed)",
      "command(ip)",
      "command(ss)",
      "command(dig)",
      "command(getent)",
      "command(resolvectl status)",
      "command(resolvectl query)",
      "command(ping -c)",
      "command(tracepath)",
      "command(docker ps)",
      "command(docker inspect)",
      "command(docker logs)",
      "command(docker stats --no-stream)",
      "command(docker images)",
      "command(docker image ls)",
      "command(docker network ls)",
      "command(docker network inspect)",
      "command(docker volume ls)",
      "command(docker volume inspect)",
      "command(docker compose ps)",
      "command(docker compose logs)",
      "command(docker compose config)",
      "command(podman ps)",
      "command(podman inspect)",
      "command(podman logs)",
      "command(podman stats --no-stream)",
      "command(podman images)",
      "command(podman image ls)",
      "command(podman network ls)",
      "command(podman network inspect)",
      "command(podman volume ls)",
      "command(podman volume inspect)",
      "command(git status)",
      "command(git log)",
      "command(git diff)",
      "command(git show)",
      "command(git branch -a)",
      "command(git branch --show-current)",
      "command(git remote -v)",
      "command(git rev-parse)"
    ]
  },
  "trustedWorkspaces": [
    "{{ .chezmoi.homeDir }}"
  ]
}
